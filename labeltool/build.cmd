@echo off
rem Builds the label tool "QL Label Formats" into ..\out\tools\QlLabelFormats.exe, the label editor "QL Label Maker"
rem into ..\out\tools\QlLabelMaker.exe, "QL Printer Status" into ..\out\tools\QlPrinterStatus.exe and the release zip's
rem setup window into ..\out\tools\Setup.exe (+ .exe.config each; icons from assets\, made by assets\make-icons.ps1)
rem (C# 5 / .NET Framework 4.8 via the inbox csc, AnyCPU -> runs natively on ARM64).
rem src\MediaTable.g.cs is generated by ..\driver\gen\media.py (run by ..\driver\build.cmd).
rem Usage: build.cmd            (from any directory; QL_TOOLS_OUT=<folder>: the exe goes there, not ..\out\tools)
setlocal
pushd "%~dp0"
set "OUT=..\out"

set "TOOLS=%OUT%\tools"
if defined QL_TOOLS_OUT set "TOOLS=%QL_TOOLS_OUT%"
if not exist "%TOOLS%" mkdir "%TOOLS%"
set "CSC=%WINDIR%\Microsoft.NET\FrameworkArm64\v4.0.30319\csc.exe"
if not exist "%CSC%" set "CSC=%WINDIR%\Microsoft.NET\Framework64\v4.0.30319\csc.exe"
set "RES="
rem The tray monitor's state icons (Brand.cs reads them by these names; it falls back to the exe's icon without them)
set "TRAY=/resource:assets\tray-ok.ico,tray-ok.ico /resource:assets\tray-warning.ico,tray-warning.ico"
set "TRAY=%TRAY% /resource:assets\tray-error.ico,tray-error.ico /resource:assets\tray-offline.ico,tray-offline.ico"
rem QL Label Maker's own mouse pointers (EditorCursors.cs reads them by these names; Windows' own without them)
set "CURSORS=/resource:assets\pan-move.cur,pan-move.cur"
rem The exes' version information (file properties, Task Manager): version\Common.cs, a title per exe, and the version
rem (the release in version\VERSION + days since 2026 + minute of day) generated here.
set "OBJ=%OUT%\obj\labeltool"
if not exist "%OBJ%" mkdir "%OBJ%"
powershell -NoProfile -ExecutionPolicy Bypass -File version\make-version.ps1 "%OBJ%\Version.g.cs" || goto :fail
set VER=version\Common.cs "%OBJ%\Version.g.cs"
rem The framework assemblies every build here references (programs and unit tests)
set "REFS=/r:System.Web.Extensions.dll /r:System.ServiceProcess.dll /r:System.Windows.Forms.dll /r:System.Drawing.dll"
rem One source folder, one exe per program: each build picks its Main with /main and has its own icon.
"%CSC%" /nologo /target:winexe /platform:anycpu /optimize+ /warnaserror+ /codepage:65001 /out:"%TOOLS%\QlLabelFormats.exe" ^
   /main:QlLabels.Program /win32icon:assets\qllabelformats.ico /win32manifest:app.manifest %RES% %TRAY% ^
   %REFS% /recurse:src\*.cs %VER% version\QlLabelFormats.cs || goto :fail
copy /y app.config "%TOOLS%\QlLabelFormats.exe.config" >nul
rem The label editor "QL Label Maker" (.qllabel files open here)
"%CSC%" /nologo /target:winexe /platform:anycpu /optimize+ /warnaserror+ /codepage:65001 /out:"%TOOLS%\QlLabelMaker.exe" ^
   /main:QlLabels.EditorProgram /win32icon:assets\qllabelmaker.ico /win32manifest:app.manifest %TRAY% %CURSORS% ^
   %REFS% /recurse:src\*.cs %VER% version\QlLabelMaker.cs || goto :fail
copy /y app.config "%TOOLS%\QlLabelMaker.exe.config" >nul
rem "QL Printer Status": status window, tray monitor, the service "QL printer status"
"%CSC%" /nologo /target:winexe /platform:anycpu /optimize+ /warnaserror+ /codepage:65001 /out:"%TOOLS%\QlPrinterStatus.exe" ^
   /main:QlLabels.PrinterStatusProgram /win32icon:assets\qlstatus.ico /win32manifest:app.manifest %TRAY% ^
   %REFS% /recurse:src\*.cs %VER% version\QlPrinterStatus.cs || goto :fail
copy /y app.config "%TOOLS%\QlPrinterStatus.exe.config" >nul
rem "Print from data" on the command line: a console exe from the same sources, so
rem scripts get its output and exit code; no window, no message boxes
"%CSC%" /nologo /target:exe /platform:anycpu /optimize+ /warnaserror+ /codepage:65001 /out:"%TOOLS%\QlLabelPrint.exe" ^
   /main:QlLabels.PrintProgram /win32icon:assets\qllabelmaker.ico /win32manifest:app.manifest %TRAY% ^
   %REFS% /recurse:src\*.cs %VER% version\QlLabelPrint.cs || goto :fail
copy /y app.config "%TOOLS%\QlLabelPrint.exe.config" >nul
rem The setup window of the release zip: the label tool's code (Program.cs opens the setup window when the exe is
rem named Setup.exe) with the setup icon. Not installed; tools\make-release.ps1 puts it into the zip.
"%CSC%" /nologo /target:winexe /platform:anycpu /optimize+ /warnaserror+ /codepage:65001 /out:"%TOOLS%\Setup.exe" ^
   /main:QlLabels.Program /win32icon:assets\qlsetup.ico /win32manifest:app.manifest %RES% %TRAY% ^
   %REFS% /recurse:src\*.cs %VER% version\Setup.cs || goto :fail
copy /y app.config "%TOOLS%\Setup.exe.config" >nul
rem Icons the install uses as files: the base mark (uninstall entry) and the .qllabel file icon
copy /y assets\qlunidrv.ico "%TOOLS%\qlunidrv.ico" >nul
copy /y assets\qllabel.ico "%TOOLS%\qllabel.ico" >nul
rem The help pages, opened in the browser from <exe folder>\help (HelpPages.cs); without the screenshot sources (shots\)
rem and the authors' README. /MIR: pages removed from help\ go here too.
robocopy help "%TOOLS%\help" /MIR /XD shots /XF README.md /NFL /NDL /NJH /NJS /NP >nul
if errorlevel 8 goto :fail

rem No colours of their own in the windows: all from src\Theme.cs (light, dark, High Contrast)
powershell -NoProfile -ExecutionPolicy Bypass -File test\check-colours.ps1 || goto :fail

rem Unit tests: printer status decoding and diagnosis, label formats, UI languages (no printer needed)
rem QL_TEST_OUT=<folder>: the test exes go there, not ..\out\test (sessions that build at the same time)
set "TESTOUT=%OUT%\test"
if defined QL_TEST_OUT set "TESTOUT=%QL_TEST_OUT%"
if not exist "%TESTOUT%" mkdir "%TESTOUT%"
"%CSC%" /nologo /target:exe /platform:anycpu /warnaserror+ /codepage:65001 /out:"%TESTOUT%\labeltool_status_test.exe" ^
   /main:QlLabels.Tests.StatusTest %REFS% ^
   /recurse:src\*.cs test\status_test.cs test\format_test.cs test\lang_test.cs || goto :fail
"%TESTOUT%\labeltool_status_test.exe" || goto :fail

rem Unit test: the setup window's helpers (result file, error messages, zip view)
"%CSC%" /nologo /target:exe /platform:anycpu /warnaserror+ /codepage:65001 /out:"%TESTOUT%\labeltool_setup_test.exe" ^
   /main:QlLabels.Tests.SetupTest %REFS% ^
   /recurse:src\*.cs test\setup_test.cs || goto :fail
"%TESTOUT%\labeltool_setup_test.exe" || goto :fail

rem Unit test: the label editor's model and 1-bit rendering (no printer needed)
"%CSC%" /nologo /target:exe /platform:anycpu /warnaserror+ /codepage:65001 /out:"%TESTOUT%\labeltool_editor_test.exe" ^
   /main:QlLabels.Tests.EditorTest %REFS% ^
   /recurse:src\*.cs test\editor_test.cs test\textedit_test.cs || goto :fail
"%TESTOUT%\labeltool_editor_test.exe" || goto :fail
rem Unit test: print from data (data fields, CSV reader, the job's checks; no printer needed)
"%CSC%" /nologo /target:exe /platform:anycpu /warnaserror+ /codepage:65001 /out:"%TESTOUT%\labeltool_printdata_test.exe" ^
   /main:QlLabels.Tests.PrintDataTest %REFS% ^
   /recurse:src\*.cs test\printdata_test.cs || goto :fail
"%TESTOUT%\labeltool_printdata_test.exe" || goto :fail
rem Unit test: QlLabelPrint.exe's options, exit codes, printer choice and roll check (fakes; no printer, no spooler)
"%CSC%" /nologo /target:exe /platform:anycpu /warnaserror+ /codepage:65001 /out:"%TESTOUT%\labeltool_printcli_test.exe" ^
   /main:QlLabels.Tests.PrintCliTest %REFS% ^
   /recurse:src\*.cs test\printcli_test.cs || goto :fail
"%TESTOUT%\labeltool_printcli_test.exe" || goto :fail

rem Unit test: paste and drop in the label editor (format order, SVG, EMF, PNG/DIB, RTF; fixtures made by the test)
"%CSC%" /nologo /target:exe /platform:anycpu /warnaserror+ /codepage:65001 /out:"%TESTOUT%\labeltool_clipboard_test.exe" ^
   /main:QlLabels.Tests.ClipboardTest %REFS% ^
   /recurse:src\*.cs test\clipboard_test.cs || goto :fail
"%TESTOUT%\labeltool_clipboard_test.exe" || goto :fail

rem Unit test: SVG text as text objects (Affinity copies as SVG; hand-written SVGs in its style)
"%CSC%" /nologo /target:exe /platform:anycpu /warnaserror+ /codepage:65001 /out:"%TESTOUT%\labeltool_svgtext_test.exe" ^
   /main:QlLabels.Tests.SvgTextTest %REFS% ^
   /recurse:src\*.cs test\svgtext_test.cs || goto :fail
"%TESTOUT%\labeltool_svgtext_test.exe" || goto :fail

rem Replay test: every clipboard dump in out\clipboard\<name> (saved from real programs, private, skipped when missing)
rem goes through the paste decision as COM data and as bytes; the expected kind comes from the dump's name. On ARM64
rem it runs natively and as x64 (the manifest lets the exe run as either).
"%CSC%" /nologo /target:exe /platform:anycpu /warnaserror+ /codepage:65001 /out:"%TESTOUT%\labeltool_clipboard_replay.exe" ^
   /main:QlLabels.Tests.ClipboardReplay /win32manifest:app.manifest %REFS% ^
   /recurse:src\*.cs test\clipboard_replay.cs || goto :fail
"%TESTOUT%\labeltool_clipboard_replay.exe" "%OUT%\clipboard" || goto :fail
set "QL_ARM64="
if /i "%PROCESSOR_ARCHITECTURE%"=="ARM64" set "QL_ARM64=1"
if /i "%PROCESSOR_ARCHITEW6432%"=="ARM64" set "QL_ARM64=1"
if defined QL_ARM64 (
   rem (start sets ERRORLEVEL to the exit code but doesn't trigger ||)
   start "" /MACHINE amd64 /B /WAIT "%TESTOUT%\labeltool_clipboard_replay.exe" "%OUT%\clipboard"
   if errorlevel 1 goto :fail
)

rem Quick fuzz test of the paste, drop and file parsers (fixed seed, 200 inputs per kind; the full run with the
rem hand-made worst cases: test\parser_fuzz.ps1)
"%CSC%" /nologo /target:exe /platform:anycpu /warnaserror+ /codepage:65001 /out:"%TESTOUT%\labeltool_parser_fuzz.exe" ^
   /main:QlLabels.Tests.ParserFuzz %REFS% ^
   /recurse:src\*.cs test\parser_fuzz.cs || goto :fail
"%TESTOUT%\labeltool_parser_fuzz.exe" 200 20261108 --quick || goto :fail

rem Unit test: QL Label Maker's tab strip and close question (layout, overflow, hit test, events; no window shown)
"%CSC%" /nologo /target:exe /platform:anycpu /warnaserror+ /codepage:65001 /out:"%TESTOUT%\labeltool_tabs_test.exe" ^
   /main:QlLabels.Tests.TabsTest %REFS% ^
   /recurse:src\*.cs test\tabs_test.cs || goto :fail
"%TESTOUT%\labeltool_tabs_test.exe" || goto :fail

rem Unit test: Code 128 sets A/B/C, Shift, FNC1 and GS1-128 element strings
"%CSC%" /nologo /target:exe /platform:anycpu /warnaserror+ /codepage:65001 /out:"%TESTOUT%\labeltool_barcode_test.exe" ^
   /main:QlLabels.Tests.BarcodeTest %REFS% ^
   /recurse:src\*.cs test\barcode_test.cs || goto :fail
"%TESTOUT%\labeltool_barcode_test.exe" || goto :fail

rem Unit test: pair kerning from the font files (GPOS, 'kern') against GDI's pairs and, with the private clipboard
rem dumps in out\clipboard, against CorelDRAW's character widths
"%CSC%" /nologo /target:exe /platform:anycpu /warnaserror+ /codepage:65001 /out:"%TESTOUT%\labeltool_kerning_test.exe" ^
   /main:QlLabels.Tests.KerningTest %REFS% ^
   /recurse:src\*.cs test\kerning_test.cs || goto :fail
"%TESTOUT%\labeltool_kerning_test.exe" "%OUT%\clipboard" || goto :fail

for %%i in ("%TOOLS%\QlLabelFormats.exe" "%TOOLS%\QlLabelMaker.exe" "%TOOLS%\QlPrinterStatus.exe" "%TOOLS%\QlLabelPrint.exe" "%TOOLS%\Setup.exe") do echo Build OK: %%~fi
popd
exit /b 0

:fail
echo BUILD FAILED
popd
exit /b 1
