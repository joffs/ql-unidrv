*Feature: AutoCut
{
    *Name: "Auto cut"
    *DefaultOption: On
    *Option: On
    {
        *Name: "On"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.10
            *CallbackID: 10
        }
    }
    *Option: Off
    {
        *Name: "Off"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.10
            *CallbackID: 11
        }
    }
}



*Feature: MirrorPrint
{
    *Name: "Mirror printing"
    *DefaultOption: Off
    *Option: Off
    {
        *Name: "Off"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.13
            *CallbackID: 18
        }
    }
    *Option: On
    {
        *Name: "On"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.13
            *CallbackID: 19
        }
    }
}

*Feature: TrimTrailingBlank
{
    *Name: "Cut tape after data (continuous)"
    *DefaultOption: Off
    *Option: Off
    {
        *Name: "Off"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.14
            *CallbackID: 30
        }
    }
    *Option: On
    {
        *Name: "On"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.14
            *CallbackID: 31
        }
    }
}

*Feature: Rotate180
{
    *Name: "Rotate 180 degrees"
    *DefaultOption: Off
    *Option: Off
    {
        *Name: "Off"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.15
            *CallbackID: 32
        }
    }
    *Option: On
    {
        *Name: "On"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.15
            *CallbackID: 33
        }
    }
}

*Command: CmdStartDoc
{
    *Order: DOC_SETUP.1
    *CallbackID: 45
}
*Command: CmdStartPage
{
    *Order: PAGE_SETUP.1
    *CallbackID: 2
}
*Command: CmdCopies
{
    *Order: DOC_SETUP.5
    *CallbackID: 5
    *Params: LIST(NumOfCopies)
}
*Command: CmdEndPage { *CallbackID: 3 }
*Command: CmdEndDoc { *CallbackID: 4 }
*Command: CmdCR { *CallbackID: 9 }
*Command: CmdLF { *CallbackID: 9 }
*Command: CmdFF { *CallbackID: 9 }
*Command: CmdSendBlockData { *CallbackID: 9 }
