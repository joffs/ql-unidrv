*Feature: AutoCut
{
    *Name: "Auto cut"
    *DefaultOption: On
    *Option: On
    {
        *Name: "On"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.10
            *CallbackID: 10
        }
    }
    *Option: Off
    {
        *Name: "Off"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.10
            *CallbackID: 11
        }
    }
}

*Feature: CutEvery
{
    *Name: "Cut every ... labels"
    *DefaultOption: N1
    *Option: N1
    {
        *Name: "1"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.11
            *CallbackID: 201
        }
    }
    *Option: N2
    {
        *Name: "2"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.11
            *CallbackID: 202
        }
    }
    *Option: N3
    {
        *Name: "3"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.11
            *CallbackID: 203
        }
    }
    *Option: N4
    {
        *Name: "4"
