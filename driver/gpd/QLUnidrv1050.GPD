        *Name: "On"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.12
            *CallbackID: 12
        }
    }
    *Option: Off
    {
        *Name: "Off"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.12
            *CallbackID: 13
        }
    }
}

*Feature: MirrorPrint
{
    *Name: "Mirror printing"
    *DefaultOption: Off
    *Option: Off
    {
        *Name: "Off"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.13
            *CallbackID: 18
        }
    }
    *Option: On
    {
        *Name: "On"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.13
            *CallbackID: 19
        }
    }
}

*Feature: TrimTrailingBlank
{
    *Name: "Cut tape after data (continuous)"
    *DefaultOption: Off
    *Option: Off
    {
        *Name: "Off"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.14
            *CallbackID: 30
        }
    }
    *Option: On
    {
        *Name: "On"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.14
            *CallbackID: 31
        }
    }
}

*Feature: Rotate180
{
    *Name: "Rotate 180 degrees"
