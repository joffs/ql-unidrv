*% @@MODELNAME@@ - independent Unidrv driver (ARM64 and x64)
*% Template: edit template.GPD.in, then run driver/gen/media.py to produce one GPD per model.
*% "@@IF option@@" ... "@@END@@" blocks are kept only for models with that option (MODELS in media.py).
*%
*% All printer bytes are produced by the render plug-in QLUnidrv.dll:
*% commands below only notify the plug-in through callbacks and emit nothing themselves.
*%   Callback IDs (must match src/plugin.cpp):
*%     1 StartDoc (QL-800; StartDoc + model: 40 + ql::Model = 41 QL-810W, 42 QL-820NWB, 43 QL-570, 44 QL-560,
*%       45 QL-550, 46 QL-500, 47 QL-650TD, 48 QL-700, 49 QL-710W, 50 QL-720NW, 51 QL-1050, 52 QL-1060N, 53 QL-580N,
*%       54 QL-1100, 55 QL-1110NWB, 56 QL-1115NWB, 57 QL-600),
*%     2 StartPage, 3 EndPage, 4 EndDoc, 5 copies (param NumOfCopies), 9 no-op
*%     10/11 auto cut on/off, 12/13 cut at end on/off, 14/15 300x300 / 300x600 dpi,
*%     16/17 speed / quality priority, 18/19 mirror off/on, 30/31 trim trailing blank off/on,
*%     32/33 rotate 0/180, 20/21 one colour / black and red (24 bpp, QL-800/810W/820NWB only),
*%     199 custom size, 200+n cut every n labels,
*%     10000 + feedDots*100 + mediaIndex  paper sizes (see gen/media.py)
*%   User label formats are Windows forms in the custom-size range (see src/labels.h).

*GPDSpecVersion: "1.0"
*CodePage: 1252
*Include: "StdNames.gpd"
*GPDFileVersion: "0.18"
*GPDFileName: "@@GPDFILE@@"
*ModelName: "@@MODELNAME@@"
*MasterUnits: PAIR(600, 600)
*ResourceDLL: "UniRes.dll"
*PrinterType: PAGE
*MaxCopies: 999
*EjectPageWithFF?: FALSE
*RotateCoordinate?: FALSE
*RotateRaster?: FALSE
*OutputDataFormat: H_BYTE
*OptimizeLeftBound?: FALSE

*Feature: Orientation
{
    *rcNameID: =ORIENTATION_DISPLAY
    *DefaultOption: PORTRAIT
    *Option: PORTRAIT
    {
        *rcNameID: =PORTRAIT_DISPLAY
    }
    *Option: LANDSCAPE_CC90
    {
        *rcNameID: =LANDSCAPE_DISPLAY
    }
}

*Feature: InputBin
{
    *rcNameID: =PAPER_SOURCE_DISPLAY
    *DefaultOption: AUTO
    *Option: AUTO
    {
        *Name: "DK roll"
    }
}

*Feature: Resolution
{
    *rcNameID: =RESOLUTION_DISPLAY
    *DefaultOption: R300
    *Option: R300
    {
        *Name: "300 x 300 dpi"
        *DPI: PAIR(300, 300)
        *TextDPI: PAIR(300, 300)
        *SpotDiameter: 100
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.3
            *CallbackID: 14
        }
    }
*% @@IF highres@@
    *Option: R300x600
    {
        *Name: "300 x 600 dpi (high resolution)"
        *DPI: PAIR(300, 600)
        *TextDPI: PAIR(300, 600)
        *SpotDiameter: 100
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.3
            *CallbackID: 15
        }
    }
*% @@END@@
}

*Feature: PrintQuality
{
    *Name: "Print priority"
    *DefaultOption: Speed
    *Option: Speed
    {
        *Name: "Speed"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.4
            *CallbackID: 16
        }
    }
    *Option: Quality
    {
        *Name: "Quality"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.4
            *CallbackID: 17
        }
    }
}

*Feature: ColorMode
{
    *rcNameID: =COLOR_PRINTING_MODE_DISPLAY
    *DefaultOption: Mono
    *Option: Mono
    {
        *rcNameID: =MONO_DISPLAY
        *% DevNumOfPlanes/DevBPP 0: the plug-in spools the raster itself (ImageProcessing returns TRUE)
        *DevNumOfPlanes: 0
        *DevBPP: 0
        *DrvBPP: 1
        *IPCallbackID: 1
        *Color? : FALSE
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.6
            *CallbackID: 20
        }
    }
@@COLORMODES@@
}

*Feature: Halftone
{
    *rcNameID: =HALFTONING_DISPLAY
    *DefaultOption: HT_PATSIZE_AUTO
    *Option: HT_PATSIZE_AUTO
    {
        *rcNameID: =HT_AUTO_SELECT_DISPLAY
    }
    *Option: HT_PATSIZE_SUPERCELL_M
    {
        *rcNameID: =HT_SUPERCELL_DISPLAY
    }
    *Option: HT_PATSIZE_6x6_M
    {
        *rcNameID: =HT_DITHER6X6_DISPLAY
    }
    *Option: HT_PATSIZE_8x8_M
    {
        *rcNameID: =HT_DITHER8X8_DISPLAY
    }
}

*Feature: PaperSize
{
    *rcNameID: =PAPER_SIZE_DISPLAY
    *DefaultOption: @@DEFAULT_PAPER@@
@@PAPERSIZES@@
}

*% @@IF autocut@@
*Feature: AutoCut
{
    *Name: "Auto cut"
    *DefaultOption: On
    *Option: On
    {
        *Name: "On"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.10
            *CallbackID: 10
        }
    }
    *Option: Off
    {
        *Name: "Off"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.10
            *CallbackID: 11
        }
    }
}
*% @@END@@

*% @@IF cutevery@@
*Feature: CutEvery
{
    *Name: "Cut every ... labels"
    *DefaultOption: N1
@@CUTEVERY@@
}
*% @@END@@

*% @@IF cutatend@@
*Feature: CutAtEnd
{
    *Name: "Cut at end"
    *DefaultOption: On
    *Option: On
    {
        *Name: "On"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.12
            *CallbackID: 12
        }
    }
    *Option: Off
    {
        *Name: "Off"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.12
            *CallbackID: 13
        }
    }
}
*% @@END@@

*Feature: MirrorPrint
{
    *Name: "Mirror printing"
    *DefaultOption: Off
    *Option: Off
    {
        *Name: "Off"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.13
            *CallbackID: 18
        }
    }
    *Option: On
    {
        *Name: "On"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.13
            *CallbackID: 19
        }
    }
}

*Feature: TrimTrailingBlank
{
    *Name: "Cut tape after data (continuous)"
    *DefaultOption: Off
    *Option: Off
    {
        *Name: "Off"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.14
            *CallbackID: 30
        }
    }
    *Option: On
    {
        *Name: "On"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.14
            *CallbackID: 31
        }
    }
}

*Feature: Rotate180
{
    *Name: "Rotate 180 degrees"
    *DefaultOption: Off
    *Option: Off
    {
        *Name: "Off"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.15
            *CallbackID: 32
        }
    }
    *Option: On
    {
        *Name: "On"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.15
            *CallbackID: 33
        }
    }
}

*Command: CmdStartDoc
{
    *Order: DOC_SETUP.1
    *CallbackID: @@STARTDOC@@
}
*Command: CmdStartPage
{
    *Order: PAGE_SETUP.1
    *CallbackID: 2
}
*Command: CmdCopies
{
    *Order: DOC_SETUP.5
    *CallbackID: 5
    *Params: LIST(NumOfCopies)
}
*Command: CmdEndPage { *CallbackID: 3 }
*Command: CmdEndDoc { *CallbackID: 4 }
*Command: CmdCR { *CallbackID: 9 }
*Command: CmdLF { *CallbackID: 9 }
*Command: CmdFF { *CallbackID: 9 }
*Command: CmdSendBlockData { *CallbackID: 9 }
